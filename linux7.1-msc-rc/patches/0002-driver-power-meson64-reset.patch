+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ * more details.
+ *
+ */
+
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/module.h>
+#include <linux/reboot.h>
+#include <linux/arm-smccc.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio/driver.h>
+
+static bool is_hc4;
+
+/* These are the confirmed IDs for your HC4 on Kernel 7.1 */
+#define VMMC_ID 600
+#define VQSW_ID 603
+#define VQEN_ID 611
+
+static noinline int __invoke_psci_fn_smc(u64 function_id, u64 arg0, u64 arg1, u64 arg2)
+{
+	struct arm_smccc_res res;
+	arm_smccc_smc((unsigned long)function_id, (unsigned long)arg0, (unsigned long)arg1, (unsigned long)arg2, 0, 0, 0, 0, &res);
+	return res.a0;
+}
+
+static void meson64_card_reset(void)
+{
+	/* If we aren't on an HC4, we get out of the car immediately */
+	if (!is_hc4)
+		return;
+
+	struct gpio_desc *vqsw = gpio_to_desc(VQSW_ID);
+	struct gpio_desc *vmmc = gpio_to_desc(VMMC_ID);
+	struct gpio_desc *vqen = gpio_to_desc(VQEN_ID);
+
+	if (!vqsw || !vmmc)
+		return;
+
+	if (vqen) {
+		gpiod_direction_output_raw(vqsw, 0);
+		gpiod_direction_output_raw(vqen, 0);
+		gpiod_direction_output_raw(vmmc, 0);
+		mdelay(100);
+		gpiod_direction_input(vqen);
+		gpiod_direction_input(vmmc);
+		gpiod_direction_input(vqsw);
+	} else {
+		gpiod_direction_output_raw(vqsw, 0);
+		mdelay(10);
+		gpiod_set_raw_value(vqsw, 1);
+		mdelay(10);
+		gpiod_direction_output_raw(vmmc, 0);
+		mdelay(10);
+		gpiod_set_raw_value(vqsw, 0);
+		gpiod_set_raw_value(vmmc, 1);
+	}
+	mdelay(5);
+}
+
+static int do_meson64_restart(struct notifier_block *this, unsigned long mode, void *cmd)
+{
+	meson64_card_reset();
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block meson64_restart_handler = {
+	.notifier_call = do_meson64_restart,
+	.priority = 130,
+};
+
+static void do_meson64_poweroff(void)
+{
+	meson64_card_reset();
+	__invoke_psci_fn_smc(0x82000042, 1, 0, 0);
+}
+
+static int meson64_restart_probe(struct platform_device *pdev)
+{
+	u32 id;
+	if (!of_property_read_u32(pdev->dev.of_node, "sys_reset", &id))
+		register_restart_handler(&meson64_restart_handler);
+
+	if (!of_property_read_u32(pdev->dev.of_node, "sys_poweroff", &id))
+		pm_power_off = do_meson64_poweroff;
+
+	/*  Only flag for the GPIO hack if we are on the HC4 */
+	if (of_machine_is_compatible("hardkernel,odroid-hc4")) {
+		is_hc4 = true;
+		pr_info("MESON64-REBOOT: Odroid-HC4 detected. SD reset hack active.\n");
+	}
+	return 0;
+}
+
+static const struct of_device_id of_meson64_restart_match[] = {
+	{ .compatible = "meson64,reboot", },
+	{},
+};
+MODULE_DEVICE_TABLE(of, of_meson64_restart_match);
+
+static struct platform_driver meson64_restart_driver = {
+	.probe = meson64_restart_probe,
+	.driver = {
+		.name = "meson64-restart",
+		.of_match_table = of_match_ptr(of_meson64_restart_match),
+	},
+};
+
+static int __init meson64_restart_init(void) { return platform_driver_register(&meson64_restart_driver); }
+device_initcall(meson64_restart_init);
+
+MODULE_AUTHOR("Amlogic, Inc.");
+MODULE_DESCRIPTION("Meson64 reboot/power-off driver with HC4-specific SD reset hack");
+MODULE_LICENSE("GPL v2");
