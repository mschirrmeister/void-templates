# Template file for 'nanopi-r76s-uboot'
pkgname=nanopi-r76s-uboot
version=2026.07rc4
revision=1
archs="aarch64*"
hostmakedepends="bison flex bc dtc which python3 swig python3-devel python3-setuptools python3-pyelftools openssl-devel libuuid-devel gnutls-devel ncurses-libtinfo-devel"
makedepends="atf-rk3576-bl31"
depends="u-boot-tools mtd-utils"
short_desc="Das U-Boot for the NanoPi R76S SBC"
maintainer="Marco Schirrmeister <mschirrmeister@gmail.com>"
license="GPL-2.0-or-later, BSD-3-Clause"
homepage="https://www.denx.de/wiki/U-Boot/"
distfiles="https://ftp.denx.de/pub/u-boot/u-boot-${version/rc/-rc}.tar.bz2
 https://raw.githubusercontent.com/rockchip-linux/rkbin/57296ad286255d98a3d409036a4b8560b6013b7d/bin/rk35/rk3576_ddr_lp4_2112MHz_lp5_2736MHz_v1.08.bin>rk3576_ddr.bin"
checksum="ac7c04b8b7004923b00a4e5d6699c5df4d21233bac9fda690d8cfbc209fff2fd
 7403cf1663d4b0c9d7c692014e0852e60f0d3977209ec75fa755c293f54e2d50"
skip_extraction="rk3576_ddr.bin"

do_configure() {
	unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
	make ${makejobs} nanopi-r76s-rk3576_defconfig
	scripts/config --enable CONFIG_USE_PREBOOT
	scripts/config --set-str CONFIG_PREBOOT 'led green on; sleep 0.1; led green off'
	scripts/config --enable CONFIG_PREBOOT_DEFINED
	scripts/config --set-val CONFIG_LOGLEVEL '7'
	scripts/config --set-val CONFIG_SPL_LOGLEVEL '7'
	scripts/config --enable CONFIG_SYS_STDIO_DEREGISTER
	scripts/config --enable CONFIG_CMD_NVEDIT_EFI
	scripts/config --enable CONFIG_CMD_NFS
	scripts/config --set-val CONFIG_NFS_TIMEOUT '2000'
	scripts/config --enable CONFIG_CMD_DNS
	scripts/config --enable CONFIG_CMD_WGET
	scripts/config --enable CONFIG_CMD_EFIDEBUG
	scripts/config --enable CONFIG_PROT_TCP
	scripts/config --enable CONFIG_PROT_TCP_SACK
	scripts/config --enable CONFIG_WGET
	scripts/config --enable CONFIG_XXHASH
	scripts/config --enable CONFIG_LZO
	scripts/config --enable CONFIG_BZIP2
	scripts/config --enable CONFIG_ZSTD
	scripts/config --enable CONFIG_ZSTD_LIB_MINIFY
	scripts/config --enable CONFIG_CMD_BTRFS
	scripts/config --enable CONFIG_FS_BTRFS
	scripts/config --enable CONFIG_MMC_SDHCI
	scripts/config --enable CONFIG_MMC_SDHCI_ROCKCHIP
	scripts/config --enable CONFIG_MMC_HS200_SUPPORT
	scripts/config --enable CONFIG_MMC_HS400_SUPPORT
	scripts/config --enable CONFIG_MMC_HS400_ES_SUPPORT
	make ${makejobs} olddefconfig
}

do_build() {
	unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
	if [ "$CROSS_BUILD" ]; then
		export CROSS_COMPILE=${XBPS_CROSS_TRIPLET}-
	fi

	# Find the ddr.bin in the stash. We look in /host/sources because
	# Void maps everything there. This avoids folder name drama.
	local ddr_src=$(find /host/sources -name "*rk3576_ddr.bin" | head -n1)
	
	if [ -z "$ddr_src" ]; then
		echo "[-] ERROR: Could not find rk3576_ddr.bin in stash!"
		exit 1
	fi

	# Copy it into the current source directory
	cp -f "$ddr_src" ./rk3576_ddr.bin
	echo "[+] Using DDR TPL from: $ddr_src"

	# Extract the current EXTRAVERSION from the Makefile
	local _extra=$(grep "^EXTRAVERSION =" Makefile | cut -d= -f2 | tr -d ' ')

	# Combine the upstream state with the Void revision
	make ${makejobs} EXTRAVERSION=${_extra}-${revision} \
		BL31=${XBPS_CROSS_BASE}/usr/lib/trusted-firmware-a/rk3576/bl31.elf \
		ROCKCHIP_TPL=./rk3576_ddr.bin
}

do_install() {
	vinstall idbloader.img 0644 usr/lib/nanopi-r76s-uboot
	vinstall u-boot.itb 0644 usr/lib/nanopi-r76s-uboot
#	vinstall u-boot-rockchip-spi.bin 0644 usr/lib/nanopi-r76s-uboot
	vinstall u-boot-rockchip.bin 0644 usr/lib/nanopi-r76s-uboot
	vdoc "${FILESDIR}/README.voidlinux"
	vlicense Licenses/README
	vlicense Licenses/gpl-2.0.txt
	vlicense Licenses/Exceptions
	vlicense Licenses/bsd-2-clause.txt
	vlicense Licenses/bsd-3-clause.txt
	vlicense Licenses/bzip2-1.0.6.txt
	vlicense Licenses/r8a779x_usb3.txt
}
